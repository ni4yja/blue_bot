{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2022",
    "lib": ["ES2022"],

    "rootDir": "./",
    /* Module Resolution */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* JavaScript Support */
    "allowJs": true,
    "checkJs": false,

    /* Type Checking */
    "strict": true,

    /* Emit */
    "declaration": false,
    "noEmit": false,
    "outDir": "./dist",
    "sourceMap": true,

    "allowSyntheticDefaultImports": true,
    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "ts-node": {
    "esm": true,
    "transpileOnly": true,
    "experimentalSpecifierResolution": "node"
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
