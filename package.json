{
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "NODE_DEBUG=module,esm node --import './register-loader.mjs' index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@atproto/api": "^0.6.20",
    "cheerio": "^1.0.0",
    "cron": "^3.1.0",
    "dotenv": "^16.3.1",
    "node-fetch": "^3.3.2",
    "process": "^0.11.10",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.7.3",
    "@types/cheerio": "^0.22.35",
    "@types/cron": "^2.4.0",
    "@types/node": "^22.7.4",
    "@types/node-fetch": "^2.6.11",
    "eslint": "^9.11.1",
    "ts-node": "^10.9.2"
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node",
    "transpileOnly": true,
    "compilerOptions": {
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "target": "ES2022"
    }
  }
}
